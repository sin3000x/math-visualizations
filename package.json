{
  "name": "math-visualizations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/config",
    "packages/scene-kit",
    "packages/video-tools",
    "projects/dual-space",
    "projects/double-dual",
    "projects/basis-coordinates",
    "templates/scene-project",
    "projects/kkt-conditions",
    "projects/dual-basis"
  ],
  "scripts": {
    "create:project": "node scripts/create-project.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "test": "node --test tests/*.test.mjs && npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run lint && npm run build && npm run test:built",
    "test:built": "node --test tests/*.test.mjs && npm run test --workspaces --if-present --ignore-scripts",
    "check:visual": "npm run check:layout --workspaces --if-present && npm run video:check --workspaces --if-present",
    "check:all": "npm run check && npm run check:visual"
  }
}
