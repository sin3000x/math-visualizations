{
  "name": "double-dual",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "video:debug": "node scripts/video/render.mjs --preset debug",
    "video:production": "node scripts/video/render.mjs --preset production",
    "video:check": "node scripts/video/render.mjs --preset production --check",
    "cover:export": "node ../scripts/export-cover.mjs double-dual"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "katex": "^0.18.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "@math-visualizations/scene-kit": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "playwright": "^1.63.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@math-visualizations/config": "0.1.0"
  }
}
